# Banco MySQL (ex.: Aiven)
DB_HOST=host-do-banco.aivencloud.com
DB_PORT=3306
DB_USER=avnadmin
DB_PASSWORD=troque-aqui
DB_NAME=defaultdb
# false para MySQL local sem SSL (a Aiven exige SSL)
DB_SSL=true

# Segredo do JWT: uma string longa e aleatória (ex.: openssl rand -base64 48)
JWT_SECRET=troque-por-um-segredo-longo
